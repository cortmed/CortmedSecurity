<?xml version="1.0" encoding="utf-8"?>
<!-- Cortmed Davranis Bekcisi icin Sysmon ayari: yalnizca asagidaki olaylar acik, geri kalan her sey kapali (onmatch="include"). -->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <EventFiltering>
    <!-- Olay 1: surec olusturma, hepsi (bos exclude = hepsini kaydet) -->
    <RuleGroup name="ProcessCreate" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
    </RuleGroup>

    <!-- Olay 5: surec sonlanma, filtresiz (surec agaci cikislara ihtiyac duyar) -->
    <RuleGroup name="ProcessTerminate" groupRelation="or">
      <ProcessTerminate onmatch="exclude" />
    </RuleGroup>

    <!-- Olay 8: uzak is parcacigi olusturma, hepsi -->
    <RuleGroup name="CreateRemoteThread" groupRelation="or">
      <CreateRemoteThread onmatch="exclude" />
    </RuleGroup>

    <!-- Olay 10: lsass.exe erisimi, yalnizca bellek okuma (PROCESS_VM_READ 0x10) iceren yaygin maskeler.
         0x1000 gibi yalniz sorgu acilislari (WMI, gorev yoneticisi) kaydedilmez. Siniflandirici ayrica (maske & 0x10) arar. -->
    <RuleGroup name="ProcessAccess" groupRelation="or">
      <ProcessAccess onmatch="include">
        <Rule name="LsassBellekOkuma" groupRelation="and">
          <TargetImage condition="end with">\lsass.exe</TargetImage>
          <GrantedAccess condition="is any">0x1010;0x1410;0x1438;0x143a;0x1fffff;0x1f1fff;0x1f3fff;0x10;0x410;0x147a;0x1418;0x1f0fff;0x1038</GrantedAccess>
        </Rule>
      </ProcessAccess>
    </RuleGroup>

    <!-- Olay 11: dosya olusturma (OneDrive'a tasinmis klasorler dahil) -->
    <RuleGroup name="FileCreate" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename condition="contains">discord_desktop_core</TargetFilename>
        <TargetFilename condition="contains">\Extensions\</TargetFilename>
        <TargetFilename condition="contains">\Documents\</TargetFilename>
        <TargetFilename condition="contains">\Desktop\</TargetFilename>
        <TargetFilename condition="contains">\Pictures\</TargetFilename>
        <TargetFilename condition="contains">\Videos\</TargetFilename>
        <TargetFilename condition="contains">\Music\</TargetFilename>
        <TargetFilename condition="contains">\Belgeler\</TargetFilename>
        <TargetFilename condition="contains">\Masaüstü\</TargetFilename>
        <TargetFilename condition="contains">\Resimler\</TargetFilename>
        <TargetFilename condition="contains">\Videolar\</TargetFilename>
        <TargetFilename condition="contains">\Müzik\</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Olay 11 gurultu azaltma: \Extensions\ icinde gelistirici klasorleri (exclude, include'dan once degerlendirilir) -->
    <RuleGroup name="FileCreateExclude" groupRelation="or">
      <FileCreate onmatch="exclude">
        <TargetFilename condition="contains">\.vscode\</TargetFilename>
        <TargetFilename condition="contains">\node_modules\</TargetFilename>
        <TargetFilename condition="contains">\.git\</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Olay 13: kayit defteri deger yazma -->
    <RuleGroup name="RegistryEvent" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">\Windows Defender\Exclusions\</TargetObject>
        <TargetObject condition="contains">DisableRealtimeMonitoring</TargetObject>
        <TargetObject condition="contains">DisableAntiSpyware</TargetObject>
        <TargetObject condition="contains">\Windows Defender\Real-Time Protection\</TargetObject>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
